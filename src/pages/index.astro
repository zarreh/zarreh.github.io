---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import MetricStrip from "@/components/MetricStrip.astro";
import WorkCard from "@/components/WorkCard.astro";
import CTABand from "@/components/CTABand.astro";
import headshot from "@/assets/images/profile/headshot.jpg";
import { affiliations, credibility, profile, proofPoints } from "@/data/profile";
import { hebProjects } from "@/data/experience";
import { principles, teaching } from "@/data/offerings";
import { formatDate, getPosts, getWork, postUrl, workUrl } from "@/lib/content";
import { personSchema, websiteSchema } from "@/lib/schema";

const work = await getWork();
const featured = work.filter((w) => w.data.featured).slice(0, 3);
const enterprise = hebProjects.filter((p) => p.featured).slice(0, 3);
const posts = (await getPosts()).slice(0, 3);

const paths = [
  {
    eyebrow: "Hiring managers & executives",
    title: "Evaluating a hands-on AI leader?",
    body: "Enterprise results in forecasting, optimization and agentic AI — and how I lead teams that ship them.",
    href: "/experience/",
    cta: "See experience",
    icon: "lucide:briefcase",
  },
  {
    eyebrow: "Clients & collaborators",
    title: "Have an AI project to get right?",
    body: "From strategy and evaluation reviews to building agentic systems and forecasting platforms.",
    href: "/work-with-me/",
    cta: "Ways to work together",
    icon: "lucide:layers",
  },
  {
    eyebrow: "Founders & boards",
    title: "Strengthening your advisory bench?",
    body: "Independent counsel on AI strategy, architecture, governance and technical due diligence.",
    href: "/advisory/",
    cta: "Board & advisory",
    icon: "lucide:landmark",
  },
];
---

<BaseLayout
  title="Ali Zarreh, Ph.D. — AI Solution Architect, Educator & Board Advisor"
  description="Ali Zarreh builds trustworthy, production AI for regulated, high-stakes businesses: agentic workflows, forecasting and optimization. AI leader at H-E-B, instructor in Johns Hopkins University and UT Austin programs, and board advisor."
  type="profile"
  jsonLd={[websiteSchema(), personSchema()]}
>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-line">
    <div class="bg-grid pointer-events-none absolute inset-0 opacity-70" aria-hidden="true"></div>
    <div
      class="container-site relative grid items-center gap-12 pt-14 pb-16 sm:pt-20 lg:grid-cols-[1.35fr_1fr] lg:pt-24 lg:pb-24"
    >
      <div>
        <p class="eyebrow">{profile.roles.join(" · ")}</p>
        <h1 class="mt-5 text-5xl leading-[1.02] font-medium tracking-tight sm:text-6xl lg:text-7xl">
          Production AI that <em class="text-accent">shows its work.</em>
        </h1>
        <p class="lead mt-7 max-w-2xl">{profile.intro}</p>
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a
            href="/work/"
            class="btn btn-primary"
            data-track="cta_click"
            data-track-label="hero_work"
          >
            See the work
            <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
          </a>
          <a
            href="/work-with-me/"
            class="btn btn-secondary"
            data-track="cta_click"
            data-track-label="hero_work_with_me">Work with me</a
          >
        </div>
        <p class="mt-8 flex items-center gap-2.5 text-sm text-muted">
          <span class="relative flex size-2.5" aria-hidden="true">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-50 motion-reduce:animate-none"
            ></span>
            <span class="relative inline-flex size-2.5 rounded-full bg-accent"></span>
          </span>
          {profile.availability}
        </p>
      </div>

      <div class="relative mx-auto w-full max-w-xs sm:max-w-sm lg:max-w-none">
        <div
          class="relative overflow-hidden rounded-[2rem] border border-line bg-sunken shadow-card"
        >
          <Image
            src={headshot}
            alt="Portrait of Ali Zarreh"
            widths={[360, 540, 720]}
            sizes="(min-width: 1024px) 420px, 80vw"
            class="aspect-[4/5] w-full object-cover object-[50%_20%]"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div
          class="card absolute -bottom-6 left-3 max-w-[15rem] p-4 sm:-left-8"
          aria-label="Credentials"
        >
          <p class="font-mono text-[0.65rem] tracking-[0.14em] text-muted uppercase">
            Ph.D. · 17+ years
          </p>
          <p class="mt-1.5 text-sm leading-snug font-medium">
            Building AI at H-E-B · Teaching in JHU & UT Austin programs
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Affiliations -->
  <div class="border-b border-line">
    <div
      class="container-site flex flex-col items-start gap-4 py-6 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="font-mono text-xs tracking-[0.14em] text-muted uppercase">
        Work, teaching & advisory
      </p>
      <ul class="flex flex-wrap gap-x-7 gap-y-2">
        {affiliations.map((a) => <li class="font-serif text-lg font-medium text-ink-soft">{a}</li>)}
      </ul>
    </div>
  </div>

  <!-- Audience paths -->
  <Section
    id="paths"
    eyebrow="Start here"
    title="Three ways people work with me"
    lead="Whether you are hiring, building or governing AI, the evidence you need is one click away."
  >
    <div class="grid gap-6 md:grid-cols-3">
      {
        paths.map((p) => (
          <a
            href={p.href}
            class="group card relative flex flex-col p-7 transition-all hover:-translate-y-0.5 hover:border-line-strong"
            data-track="audience_path"
            data-track-label={p.href}
          >
            <span class="grid size-11 place-items-center rounded-xl bg-accent-soft text-accent">
              <Icon name={p.icon} class="size-5" aria-hidden="true" />
            </span>
            <p class="eyebrow mt-6 text-muted">{p.eyebrow}</p>
            <h3 class="mt-2 text-2xl leading-snug font-medium">{p.title}</h3>
            <p class="mt-3 leading-relaxed text-ink-soft">{p.body}</p>
            <span class="mt-6 inline-flex items-center gap-1.5 pt-2 text-sm font-semibold text-accent">
              {p.cta}
              <Icon
                name="lucide:arrow-right"
                class="size-4 transition-transform group-hover:translate-x-0.5"
                aria-hidden="true"
              />
            </span>
          </a>
        ))
      }
    </div>
  </Section>

  <!-- Proof -->
  <Section
    id="results"
    tone="sunken"
    eyebrow="Enterprise results"
    title="Measured in production, not in a demo"
    lead="Selected outcomes from platforms I have architected and led at H-E-B."
  >
    <MetricStrip items={proofPoints} size="lg" />
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        enterprise.map((p) => (
          <WorkCard
            href={`/experience/#${p.id}`}
            title={p.title}
            summary={p.summary}
            status="enterprise"
            domains={p.domains}
            capabilities={p.capabilities}
            metric={p.outcomes[0]}
          />
        ))
      }
    </div>
    <p class="mt-8">
      <a href="/experience/" class="link text-sm font-semibold">All enterprise work and roles →</a>
    </p>
  </Section>

  <!-- Featured independent work -->
  <Section
    id="featured-work"
    eyebrow="Public portfolio"
    title="AI for regulated decisions, built in the open"
    lead="Live applications in finance and healthcare, each with independent checks, human review and openly reported limits."
  >
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        featured.map((entry, i) => (
          <WorkCard
            href={workUrl(entry)}
            title={entry.data.title}
            summary={entry.data.summary}
            status={entry.data.status}
            domains={entry.data.domains}
            capabilities={entry.data.capabilities}
            cover={entry.data.cover}
            coverAlt={entry.data.coverAlt}
            eager={i === 0}
          />
        ))
      }
    </div>
    <div class="mt-10 flex flex-wrap items-center gap-3">
      <a href="/work/" class="btn btn-secondary">
        Browse all {work.length} case studies
        <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
      </a>
    </div>
  </Section>

  <!-- Principles -->
  <Section
    id="principles"
    tone="sunken"
    eyebrow="How I work"
    title="Principles I build and advise by"
  >
    <ol
      class="grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-5"
    >
      {
        principles.map((p, i) => (
          <li class="flex flex-col bg-elevated p-6">
            <span class="font-mono text-xs text-accent">0{i + 1}</span>
            <h3 class="mt-3 font-sans text-base leading-snug font-semibold">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">{p.body}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- Teaching & advisory -->
  <Section id="beyond" eyebrow="Beyond the day job" title="Teaching, advising and research">
    <div class="grid gap-6 lg:grid-cols-3">
      <a
        href="/speaking/"
        class="group card flex flex-col p-7 transition-colors hover:border-line-strong"
      >
        <p class="eyebrow text-muted">Teaching</p>
        <p class="mt-4 font-serif text-5xl font-medium text-accent">{teaching.stats[0].value}</p>
        <p class="mt-1 text-sm text-muted">
          students · {teaching.stats[1].value} rating
        </p>
        <p class="mt-4 leading-relaxed text-ink-soft">
          Instructor for the Agentic AI and Applied Generative AI programs offered by Johns Hopkins
          University and UT Austin.
        </p>
        <span class="mt-auto pt-6 text-sm font-semibold text-accent">Speaking & teaching →</span>
      </a>
      <a
        href="/advisory/"
        class="group card flex flex-col p-7 transition-colors hover:border-line-strong"
      >
        <p class="eyebrow text-muted">Board advisory</p>
        <p class="mt-4 font-serif text-3xl leading-tight font-medium">Syne Life</p>
        <p class="mt-1 text-sm text-muted">Health Tech Board Advisor · AI & Technology</p>
        <p class="mt-4 leading-relaxed text-ink-soft">
          Advising the founding team of a recovery-science wellness startup on technology strategy,
          platform architecture and AI.
        </p>
        <span class="mt-auto pt-6 text-sm font-semibold text-accent">Board & advisory →</span>
      </a>
      <a
        href="/research/"
        class="group card flex flex-col p-7 transition-colors hover:border-line-strong"
      >
        <p class="eyebrow text-muted">Research</p>
        <p class="mt-4 font-serif text-3xl leading-tight font-medium">Game theory & security</p>
        <p class="mt-1 text-sm text-muted">Ph.D., University of Texas at San Antonio</p>
        <p class="mt-4 leading-relaxed text-ink-soft">
          Peer-reviewed work on cyber-physical security, risk and operations — the quantitative
          roots of how I reason about AI risk today.
        </p>
        <span class="mt-auto pt-6 text-sm font-semibold text-accent">Publications →</span>
      </a>
    </div>
    <dl class="mt-10 grid grid-cols-2 gap-6 border-t border-line pt-8 lg:grid-cols-4">
      {
        credibility.map((c) => (
          <div class="flex flex-col">
            <dt class="text-sm text-muted">{c.label}</dt>
            <dd class="order-first font-serif text-3xl font-medium">{c.value}</dd>
          </div>
        ))
      }
    </dl>
  </Section>

  {
    posts.length > 0 && (
      <Section
        id="writing"
        tone="sunken"
        eyebrow="Writing"
        title="Notes on building trustworthy AI"
      >
        <ul class="grid gap-6 md:grid-cols-3">
          {posts.map((post) => (
            <li class="card p-6">
              <p class="font-mono text-xs text-muted">{formatDate(post.data.date, "short")}</p>
              <h3 class="mt-3 text-xl leading-snug font-medium">
                <a href={postUrl(post)} class="hover:text-accent">
                  {post.data.title}
                </a>
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-ink-soft">{post.data.description}</p>
            </li>
          ))}
        </ul>
        <p class="mt-8">
          <a href="/writing/" class="link text-sm font-semibold">
            All writing →
          </a>
        </p>
      </Section>
    )
  }

  <CTABand />
</BaseLayout>
