---
import { Icon } from "astro-icon/components";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import Section from "@/components/Section.astro";
import CTABand from "@/components/CTABand.astro";
import { roles } from "@/data/experience";
import {
  advisoryAreas,
  advisoryFormats,
  faqs,
  principles,
  process,
  services,
} from "@/data/offerings";
import { env } from "@/data/profile";
import { breadcrumbSchema } from "@/lib/schema";

const syne = roles.find((r) => r.id === "syne-life")!;

const why = [
  {
    title: "Operator, not commentator",
    body: "I run AI programs inside a large enterprise today — architecture, evaluation, teams and executive stakeholders — so my advice comes from what actually ships.",
  },
  {
    title: "Risk is my home turf",
    body: "A Ph.D. in game-theoretic security and a portfolio of AI systems for credit, clinical and compliance decisions: I think about failure modes before features.",
  },
  {
    title: "Strategy that survives contact",
    body: "I translate between board-level questions and engineering reality — cost, timelines, data readiness and what the model can and cannot do.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<BaseLayout
  title="Advisory & consulting — AI projects, strategy and board advisory · Ali Zarreh"
  description="Work with Ali Zarreh on AI projects, consulting and advisory: AI strategy and readiness, agentic AI from prototype to production, forecasting and optimization, AI evaluation and guardrails reviews, workshops, and board or fractional advisory."
  jsonLd={[
    faqSchema,
    breadcrumbSchema([
      { name: "Home", path: "/" },
      { name: "Advisory & consulting", path: "/advisory/" },
    ]),
  ]}
>
  <PageHeader
    eyebrow="Advisory & consulting"
    title="Hands-on help with the AI decisions that matter."
    lead="Whether you need a system built, an existing one reviewed, or an independent technical voice at the table, I work directly with your team — from framing the problem to production code and the governance around it."
  >
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="/contact/?topic=project"
        class="btn btn-primary"
        data-track="cta_click"
        data-track-label="advisory_header"
      >
        Discuss it with me
      </a>
      <a href="#projects" class="btn btn-secondary">Ways to work together</a>
      {
        env.bookingUrl && (
          <a
            href={env.bookingUrl}
            class="btn btn-secondary"
            target="_blank"
            rel="noopener"
            data-track="book_call"
            data-track-label="advisory_header"
          >
            <Icon name="lucide:calendar" class="size-4" aria-hidden="true" />
            Book a call
          </a>
        )
      }
    </div>
  </PageHeader>

  <Section
    id="projects"
    eyebrow="Projects & consulting"
    title="How I can help"
    lead="Fixed-scope reviews, build engagements and workshops, in any industry."
  >
    <div class="space-y-6">
      {
        services.map((s, i) => (
          <article
            id={s.id}
            class="card grid scroll-mt-24 gap-6 p-6 sm:p-8 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)]"
          >
            <div>
              <div class="flex items-center gap-3">
                <span class="font-mono text-xs text-accent">0{i + 1}</span>
                <span class="chip">{s.format}</span>
              </div>
              <h3 class="mt-3 text-2xl font-medium sm:text-3xl">{s.title}</h3>
              <p class="mt-2 font-serif text-lg text-ink-soft italic">{s.lead}</p>
              <p class="mt-4 leading-relaxed text-ink-soft">{s.body}</p>
            </div>
            <div class="rounded-xl bg-sunken p-5">
              <p class="font-mono text-xs tracking-[0.12em] text-muted uppercase">You get</p>
              <ul class="mt-3 space-y-2">
                {s.deliverables.map((d) => (
                  <li class="flex gap-2.5 text-sm text-ink-soft">
                    <Icon
                      name="lucide:check"
                      class="mt-0.5 size-4 shrink-0 text-accent"
                      aria-hidden="true"
                    />
                    {d}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </Section>

  <Section
    id="advisory"
    tone="sunken"
    eyebrow="Advisory"
    title="Board and fractional advisory"
    lead="Ongoing counsel for founders, executive teams and boards on AI strategy, architecture and governance."
  >
    <div class="grid gap-6 md:grid-cols-2">
      {
        advisoryFormats.map((f) => (
          <div class="flex gap-4 rounded-2xl border border-line bg-elevated p-6">
            <Icon
              name="lucide:circle-check"
              class="mt-0.5 size-5 shrink-0 text-accent"
              aria-hidden="true"
            />
            <div>
              <h3 class="font-sans text-lg font-semibold">{f.title}</h3>
              <p class="mt-1 leading-relaxed text-ink-soft">{f.body}</p>
            </div>
          </div>
        ))
      }
    </div>

    <p class="mt-12 font-mono text-xs tracking-[0.12em] text-muted uppercase">Current role</p>
    <article
      class="card mt-4 grid gap-6 p-6 sm:p-8 md:grid-cols-[1fr_2fr] md:items-center"
      aria-label={`${syne.org} — ${syne.title}`}
    >
      <div>
        <p class="font-mono text-xs tracking-wide text-muted uppercase">
          {syne.period} · {syne.location}
        </p>
        <h3 class="mt-2 text-3xl font-medium">{syne.org}</h3>
        <p class="text-ink-soft">{syne.title}</p>
        {
          syne.website && (
            <a
              href={syne.website}
              class="link mt-3 inline-flex items-center gap-1.5 text-sm font-medium"
              target="_blank"
              rel="noopener"
            >
              {new URL(syne.website).hostname}
              <Icon name="lucide:arrow-up-right" class="size-4" aria-hidden="true" />
            </a>
          )
        }
      </div>
      <div class="space-y-3 leading-relaxed text-ink-soft">
        <p>{syne.summary}</p>
        {syne.highlights?.map((h) => <p>{h}</p>)}
      </div>
    </article>
  </Section>

  <Section eyebrow="What I bring" title="Where I add the most value">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        advisoryAreas.map((a) => (
          <div class="card p-6">
            <h3 class="font-sans text-lg font-semibold">{a.title}</h3>
            <p class="mt-2 leading-relaxed text-ink-soft">{a.body}</p>
          </div>
        ))
      }
    </div>
    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {
        why.map((w) => (
          <div class="border-t-2 border-accent pt-5">
            <h3 class="font-sans text-base font-semibold">{w.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">{w.body}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Section id="process" tone="sunken" eyebrow="Process" title="How we'd work together">
    <ol class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {
        process.map((p, i) => (
          <li class="relative">
            <span class="grid size-10 place-items-center rounded-full bg-ink font-mono text-sm text-bg">
              {i + 1}
            </span>
            <h3 class="mt-4 font-sans text-lg font-semibold">{p.title}</h3>
            <p class="mt-2 leading-relaxed text-ink-soft">{p.body}</p>
          </li>
        ))
      }
    </ol>
    <div class="mt-12 rounded-2xl border border-line bg-elevated p-6 sm:p-8">
      <p class="font-mono text-xs tracking-[0.12em] text-muted uppercase">How I work and advise</p>
      <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {
          principles.map((p) => (
            <li>
              <p class="font-semibold">{p.title}</p>
              <p class="mt-1 text-sm text-ink-soft">{p.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Section id="faq" eyebrow="FAQ" title="Common questions">
    <div class="max-w-3xl divide-y divide-line rounded-2xl border border-line bg-elevated">
      {
        faqs.map((f) => (
          <details class="group p-5 sm:p-6">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold">
              {f.q}
              <Icon
                name="lucide:plus"
                class="size-5 shrink-0 text-muted transition-transform group-open:rotate-45"
                aria-hidden="true"
              />
            </summary>
            <p class="mt-3 leading-relaxed text-ink-soft">{f.a}</p>
          </details>
        ))
      }
    </div>
  </Section>

  <CTABand
    title="Have a project, a decision or a board seat in mind?"
    body="Tell me what you're working on. If AI is the right tool, I'll help you get it right; if it isn't, I'll tell you that too."
    primary={{ href: "/contact/", label: "Discuss it with me" }}
    topic="project"
  />
</BaseLayout>
