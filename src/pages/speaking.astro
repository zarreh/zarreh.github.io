---
import { Icon } from "astro-icon/components";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import Section from "@/components/Section.astro";
import CTABand from "@/components/CTABand.astro";
import MetricStrip from "@/components/MetricStrip.astro";
import { talkTopics, teaching } from "@/data/offerings";
import { breadcrumbSchema } from "@/lib/schema";

const formats = [
  {
    icon: "lucide:mic",
    title: "Keynotes & conference talks",
    body: "Practical, evidence-based talks on deploying AI where mistakes are expensive.",
  },
  {
    icon: "lucide:users",
    title: "Workshops",
    body: "Hands-on sessions for engineering teams on agents, retrieval, evaluation and guardrails.",
  },
  {
    icon: "lucide:landmark",
    title: "Executive & board briefings",
    body: "A clear picture of AI opportunity, risk and governance for decision-makers.",
  },
  {
    icon: "lucide:graduation-cap",
    title: "Guest lectures & panels",
    body: "University programs, meetups and panels on applied AI and operations research.",
  },
];
---

<BaseLayout
  title="Speaking & teaching · Ali Zarreh"
  description="Ali Zarreh teaches the Agentic AI and Applied Generative AI programs offered by Johns Hopkins University and UT Austin (250+ students, 4.92/5) and speaks on trustworthy AI, agentic systems, evaluation and forecasting."
  jsonLd={breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Speaking", path: "/speaking/" },
  ])}
>
  <PageHeader
    eyebrow="Speaking & teaching"
    title="Teaching what works in production."
    lead="I teach practitioners to build generative and agentic AI that holds up outside the notebook — and I speak to leaders about what it takes to trust it."
  >
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="/contact/?topic=speaking"
        class="btn btn-primary"
        data-track="cta_click"
        data-track-label="speaking_header"
      >
        Invite me to speak
      </a>
      <a href="/advisory/#press-kit" class="btn btn-secondary">Bios & headshots</a>
    </div>
  </PageHeader>

  <Section eyebrow="Teaching" title="Johns Hopkins University & UT Austin programs">
    <MetricStrip items={teaching.stats} size="lg" />
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        teaching.programs.map((p) => (
          <div class="card p-6">
            <h3 class="font-sans text-lg font-semibold">{p.title}</h3>
            <p class="mt-1 text-sm text-muted">{p.org}</p>
            <p class="mt-3 leading-relaxed text-ink-soft">{p.body}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Section
    tone="sunken"
    eyebrow="Talks"
    title="Topics I speak on"
    lead="Each can be tailored for practitioners, leadership teams or a general technical audience."
  >
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        talkTopics.map((t) => (
          <article class="card flex flex-col p-6">
            <p class="font-mono text-[0.7rem] tracking-wide text-accent uppercase">{t.audience}</p>
            <h3 class="mt-3 text-xl font-medium">{t.title}</h3>
            <p class="mt-2 leading-relaxed text-ink-soft">{t.body}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <Section eyebrow="Formats" title="Ways to bring me in">
    <div class="grid gap-6 sm:grid-cols-2">
      {
        formats.map((f) => (
          <div class="flex gap-4">
            <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-accent-soft text-accent">
              <Icon name={f.icon} class="size-5" aria-hidden="true" />
            </span>
            <div>
              <h3 class="font-sans text-lg font-semibold">{f.title}</h3>
              <p class="mt-1 leading-relaxed text-ink-soft">{f.body}</p>
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  <CTABand
    title="Planning an event or a team workshop?"
    body="Share the audience, the format and the date, and I'll suggest a topic that fits."
    primary={{ href: "/contact/", label: "Invite me to speak" }}
    topic="speaking"
  />
</BaseLayout>
