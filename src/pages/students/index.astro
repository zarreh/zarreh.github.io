---
import { Icon } from "astro-icon/components";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import Section from "@/components/Section.astro";
import { teaching } from "@/data/offerings";
import { breadcrumbSchema } from "@/lib/schema";

const programs = teaching.programs.filter((p) => p.href);

const materials = [
  {
    icon: "lucide:presentation",
    title: "Slides & session notes",
    body: "The decks and annotated notes from each live session, organized by module.",
  },
  {
    icon: "lucide:code",
    title: "Notebooks & code",
    body: "Runnable notebooks and reference implementations for the techniques we cover.",
  },
  {
    icon: "lucide:briefcase",
    title: "Case studies & project templates",
    body: "Starter repositories, rubrics and worked examples for the hands-on projects.",
  },
  {
    icon: "lucide:book-open",
    title: "Reading lists",
    body: "Papers, documentation and articles that go deeper than the session itself.",
  },
  {
    icon: "lucide:video",
    title: "Session recaps",
    body: "Short summaries of each session, with links to recordings where they are shared.",
  },
  {
    icon: "lucide:megaphone",
    title: "Announcements & office hours",
    body: "Schedule changes, office-hour times and anything else your cohort needs to know.",
  },
];

const access = [
  {
    title: "Sign in with your program email",
    body: "Use the email address you registered with for the program.",
  },
  {
    title: "See your program and cohort",
    body: "Materials are organized by program and course, so you only see what's relevant to you.",
  },
  {
    title: "Ask when you're stuck",
    body: "Questions about the materials or access go through the contact page.",
  },
];
---

<BaseLayout
  title="Students — course materials for my programs · Ali Zarreh"
  description="Course materials for students in the Johns Hopkins University and UT Austin McCombs AI programs Ali Zarreh teaches: slides, notebooks, project templates, reading lists and session recaps, organized by program and course."
  jsonLd={breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Students", path: "/students/" },
  ])}
>
  <PageHeader
    eyebrow="Students"
    title="Course materials, in one place."
    lead="If you're in one of the programs I teach, this is where you'll find the materials for your program and course — slides, notebooks, project templates and reading lists — once you sign in."
  >
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a href="/students/login/" class="btn btn-primary">
        <Icon name="lucide:log-in" class="size-4" aria-hidden="true" />
        Student sign-in
      </a>
      <a href="#programs" class="btn btn-secondary">Find your program</a>
    </div>
    <p
      class="mt-6 inline-flex items-center gap-2 rounded-full bg-warm-soft px-3 py-1.5 text-sm text-ink-soft"
    >
      <Icon name="lucide:clock" class="size-4 text-warm" aria-hidden="true" />
      Student access is being set up. Materials will appear here as each cohort starts.
    </p>
  </PageHeader>

  <Section
    id="programs"
    eyebrow="Programs"
    title="Find your program"
    lead="Materials are organized by program, then by course and cohort."
  >
    <div class="grid gap-6 md:grid-cols-3">
      {
        programs.map((p) => (
          <article id={p.id} class="card flex scroll-mt-24 flex-col p-6">
            <div class="flex items-center justify-between gap-3">
              <p class="font-mono text-[0.7rem] tracking-wide text-muted uppercase">
                {p.institution}
              </p>
              <span class="rounded-full bg-sunken px-2 py-0.5 font-mono text-[0.65rem] text-muted uppercase">
                Coming soon
              </span>
            </div>
            <h3 class="mt-3 font-serif text-xl leading-snug font-medium">{p.title}</h3>
            {p.skills && (
              <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Skills taught">
                {p.skills.slice(0, 6).map((s) => (
                  <li class="chip">{s}</li>
                ))}
              </ul>
            )}
            <div class="mt-auto flex flex-wrap gap-x-5 gap-y-2 pt-6 text-sm font-semibold">
              <a href="/students/login/" class="link inline-flex items-center gap-1.5">
                Materials
                <span class="sr-only">for {p.title}</span>
                <Icon name="lucide:lock" class="size-3.5" aria-hidden="true" />
              </a>
              <a
                href={p.href}
                class="link inline-flex items-center gap-1.5"
                target="_blank"
                rel="noopener"
              >
                Program page
                <span class="sr-only">: {p.title}</span>
                <Icon name="lucide:arrow-up-right" class="size-4" aria-hidden="true" />
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </Section>

  <Section tone="sunken" eyebrow="What you'll find" title="What's in each course">
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        materials.map((m) => (
          <li class="flex gap-4">
            <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-accent-soft text-accent">
              <Icon name={m.icon} class="size-5" aria-hidden="true" />
            </span>
            <div>
              <h3 class="font-sans text-lg font-semibold">{m.title}</h3>
              <p class="mt-1 leading-relaxed text-ink-soft">{m.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section eyebrow="Access" title="How access works">
    <div class="grid gap-10 lg:grid-cols-[1.4fr_1fr] lg:items-start">
      <ol class="space-y-6">
        {
          access.map((a, i) => (
            <li class="flex gap-4">
              <span class="grid size-9 shrink-0 place-items-center rounded-full bg-ink font-mono text-sm text-bg">
                {i + 1}
              </span>
              <div>
                <h3 class="font-sans text-lg font-semibold">{a.title}</h3>
                <p class="mt-1 leading-relaxed text-ink-soft">{a.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="card p-6">
        <p class="font-semibold">Already enrolled?</p>
        <p class="mt-1.5 text-sm leading-relaxed text-muted">
          Sign in to see your program's materials. Can't sign in yet? Send me a note and I'll share
          what your cohort needs.
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <a href="/students/login/" class="btn btn-primary">Student sign-in</a>
          <a href="/contact/?topic=student" class="btn btn-secondary">Contact me</a>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>
