---
import { Icon } from "astro-icon/components";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import Section from "@/components/Section.astro";
import CTABand from "@/components/CTABand.astro";
import WorkCard from "@/components/WorkCard.astro";
import { env } from "@/data/profile";
import { faqs, process, services } from "@/data/offerings";
import { getWork, workUrl } from "@/lib/content";
import { breadcrumbSchema } from "@/lib/schema";

const proof = (await getWork()).filter((w) => w.data.featured).slice(0, 3);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<BaseLayout
  title="Work with me — AI strategy, agentic AI, forecasting & evaluation · Ali Zarreh"
  description="Engage Ali Zarreh for AI strategy and readiness assessments, agentic AI from prototype to production, forecasting and optimization, AI evaluation and guardrails reviews, and team workshops."
  jsonLd={[
    faqSchema,
    breadcrumbSchema([
      { name: "Home", path: "/" },
      { name: "Work with me", path: "/work-with-me/" },
    ]),
  ]}
>
  <PageHeader
    eyebrow="Work with me"
    title="Get the AI decision right, then build it properly."
    lead="I take on a small number of engagements where rigor matters: regulated data, expensive mistakes, and teams who want a system they can operate — not just a demo."
  >
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="/contact/?topic=project"
        class="btn btn-primary"
        data-track="cta_click"
        data-track-label="services_header"
      >
        Start a conversation
      </a>
      {
        env.bookingUrl && (
          <a
            href={env.bookingUrl}
            class="btn btn-secondary"
            target="_blank"
            rel="noopener"
            data-track="book_call"
            data-track-label="services_header"
          >
            <Icon name="lucide:calendar" class="size-4" aria-hidden="true" />
            Book a call
          </a>
        )
      }
    </div>
  </PageHeader>

  <Section eyebrow="Engagements" title="How I can help">
    <div class="space-y-6">
      {
        services.map((s, i) => (
          <article
            id={s.id}
            class="card grid scroll-mt-24 gap-6 p-6 sm:p-8 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)]"
          >
            <div>
              <div class="flex items-center gap-3">
                <span class="font-mono text-xs text-accent">0{i + 1}</span>
                <span class="chip">{s.format}</span>
              </div>
              <h3 class="mt-3 text-2xl font-medium sm:text-3xl">{s.title}</h3>
              <p class="mt-2 font-serif text-lg text-ink-soft italic">{s.lead}</p>
              <p class="mt-4 leading-relaxed text-ink-soft">{s.body}</p>
            </div>
            <div class="rounded-xl bg-sunken p-5">
              <p class="font-mono text-xs tracking-[0.12em] text-muted uppercase">You get</p>
              <ul class="mt-3 space-y-2">
                {s.deliverables.map((d) => (
                  <li class="flex gap-2.5 text-sm text-ink-soft">
                    <Icon
                      name="lucide:check"
                      class="mt-0.5 size-4 shrink-0 text-accent"
                      aria-hidden="true"
                    />
                    {d}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </Section>

  <Section tone="sunken" eyebrow="Process" title="What working together looks like">
    <ol class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {
        process.map((p, i) => (
          <li class="relative">
            <span class="grid size-10 place-items-center rounded-full bg-ink font-mono text-sm text-bg">
              {i + 1}
            </span>
            <h3 class="mt-4 font-sans text-lg font-semibold">{p.title}</h3>
            <p class="mt-2 leading-relaxed text-ink-soft">{p.body}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section
    eyebrow="Proof"
    title="The standard I build to"
    lead="These public applications show the patterns I bring to client work: verifiers, guardrails, human review and honest limits."
  >
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        proof.map((entry) => (
          <WorkCard
            href={workUrl(entry)}
            title={entry.data.title}
            summary={entry.data.summary}
            status={entry.data.status}
            domains={entry.data.domains}
            capabilities={entry.data.capabilities}
            cover={entry.data.cover}
            coverAlt={entry.data.coverAlt}
          />
        ))
      }
    </div>
  </Section>

  <Section tone="sunken" eyebrow="FAQ" title="Common questions">
    <div class="max-w-3xl divide-y divide-line rounded-2xl border border-line bg-elevated">
      {
        faqs.map((f) => (
          <details class="group p-5 sm:p-6">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold">
              {f.q}
              <Icon
                name="lucide:plus"
                class="size-5 shrink-0 text-muted transition-transform group-open:rotate-45"
                aria-hidden="true"
              />
            </summary>
            <p class="mt-3 leading-relaxed text-ink-soft">{f.a}</p>
          </details>
        ))
      }
    </div>
  </Section>

  <CTABand
    title="Tell me about the decision you want to improve."
    body="If AI is the right tool, I'll help you build it properly. If it isn't, I'll tell you that too."
    primary={{ href: "/contact/", label: "Start a conversation" }}
    topic="project"
  />
</BaseLayout>
