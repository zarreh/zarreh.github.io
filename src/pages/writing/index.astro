---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import CTABand from "@/components/CTABand.astro";
import { formatDate, getPosts, postUrl, readingTime } from "@/lib/content";
import { breadcrumbSchema } from "@/lib/schema";
import { slugify } from "@/lib/slug";

const posts = await getPosts();
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<BaseLayout
  title="Writing — Notes on trustworthy, production AI · Ali Zarreh"
  description="Essays by Ali Zarreh on building AI that shows its work: evaluation, guardrails, agentic systems, forecasting and AI governance."
  jsonLd={breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Writing", path: "/writing/" },
  ])}
>
  <PageHeader
    eyebrow="Writing"
    title="Notes on building AI people can trust."
    lead="Lessons from shipping AI where mistakes are expensive — evaluation, guardrails, agents, forecasting and governance. No hype, real numbers."
  >
    <p class="mt-6 text-sm text-muted">
      Subscribe via <a href="/rss.xml" class="link">RSS</a>.
    </p>
  </PageHeader>

  <section class="container-site py-14">
    {
      tags.length > 0 && (
        <ul class="mb-10 flex flex-wrap gap-2" aria-label="Topics">
          {tags.map((t) => (
            <li>
              <a href={`/writing/tags/${slugify(t)}/`} class="chip hover:border-ink hover:text-ink">
                {t}
              </a>
            </li>
          ))}
        </ul>
      )
    }
    {
      posts.length === 0 ? (
        <p class="text-muted">The first essays are on their way.</p>
      ) : (
        <ul class="divide-y divide-line border-y border-line">
          {posts.map((post) => (
            <li class="grid gap-3 py-8 md:grid-cols-[10rem_minmax(0,1fr)]">
              <p class="font-mono text-xs text-muted">
                <time datetime={post.data.date.toISOString()}>
                  {formatDate(post.data.date, "short")}
                </time>
                <span class="block">{readingTime(post.body)} min read</span>
              </p>
              <div>
                <h2 class="text-2xl leading-snug font-medium sm:text-3xl">
                  <a href={postUrl(post)} class="hover:text-accent">
                    {post.data.title}
                  </a>
                </h2>
                <p class="mt-2 max-w-3xl leading-relaxed text-ink-soft">{post.data.description}</p>
                <p class="mt-3 flex flex-wrap gap-1.5">
                  {post.data.tags.map((t) => (
                    <span class="chip">{t}</span>
                  ))}
                </p>
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <CTABand />
</BaseLayout>
