---
import { Icon } from "astro-icon/components";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import Section from "@/components/Section.astro";
import WorkCard from "@/components/WorkCard.astro";
import CTABand from "@/components/CTABand.astro";
import { hebProjects } from "@/data/experience";
import { labItems, otherWork } from "@/data/lab";
import {
  capabilities,
  domains,
  statuses,
  type CapabilityKey,
  type DomainKey,
} from "@/data/taxonomy";
import { getWork, workUrl } from "@/lib/content";
import { breadcrumbSchema } from "@/lib/schema";

const work = await getWork();

const items = [
  ...work.map((w) => ({
    href: workUrl(w),
    title: w.data.title,
    summary: w.data.summary,
    status: w.data.status,
    domains: w.data.domains,
    capabilities: w.data.capabilities,
    cover: w.data.cover,
    coverAlt: w.data.coverAlt,
    metric: undefined,
  })),
  ...hebProjects.map((p) => ({
    href: `/experience/#${p.id}`,
    title: p.title,
    summary: p.summary,
    status: "enterprise" as const,
    domains: p.domains,
    capabilities: p.capabilities,
    cover: undefined,
    coverAlt: undefined,
    metric: p.outcomes[0],
  })),
];

const usedDomains = (Object.keys(domains) as DomainKey[]).filter((d) =>
  items.some((i) => i.domains.includes(d)),
);
const usedCapabilities = (Object.keys(capabilities) as CapabilityKey[]).filter((c) =>
  items.some((i) => i.capabilities.includes(c)),
);
const statusFilters = (["live", "enterprise", "open-source"] as const).filter((s) =>
  items.some((i) => i.status === s),
);

const filterGroups = [
  {
    key: "status",
    label: "Type",
    options: statusFilters.map((s) => ({ value: s, label: statuses[s] })),
  },
  {
    key: "domains",
    label: "Industry",
    options: usedDomains.map((d) => ({ value: d, label: domains[d] })),
  },
  {
    key: "capabilities",
    label: "Capability",
    options: usedCapabilities.map((c) => ({ value: c, label: capabilities[c] })),
  },
];
---

<BaseLayout
  title="Work — Case studies in agentic AI, forecasting & optimization · Ali Zarreh"
  description="Case studies from Ali Zarreh: live AI applications for finance, healthcare and insurance with verifiers and human review, plus enterprise forecasting, optimization and agentic-AI platforms."
  jsonLd={breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Work", path: "/work/" },
  ])}
>
  <PageHeader
    eyebrow="Work"
    title="Case studies"
    lead="Enterprise platforms in production, and a public portfolio of AI applications for regulated decisions — each one explicit about what is AI, what is code, what is checked and where a human decides."
  />

  <section class="container-site py-12" aria-label="Case study library">
    <form
      class="flex flex-col gap-5 border-b border-line pb-8"
      data-work-filters
      aria-label="Filter case studies"
      onsubmit="return false"
    >
      {
        filterGroups.map((group) => (
          <fieldset class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-4">
            <legend class="float-left w-24 shrink-0 font-mono text-xs tracking-[0.12em] text-muted uppercase sm:pt-0">
              {group.label}
            </legend>
            <div class="flex flex-wrap gap-2">
              <label class="filter-pill">
                <input type="radio" name={group.key} value="" checked class="sr-only" />
                <span>All</span>
              </label>
              {group.options.map((o) => (
                <label class="filter-pill">
                  <input type="radio" name={group.key} value={o.value} class="sr-only" />
                  <span>{o.label}</span>
                </label>
              ))}
            </div>
          </fieldset>
        ))
      }
      <p class="text-sm text-muted" aria-live="polite">
        Showing <span data-work-count>{items.length}</span> of {items.length} case studies
        <button type="reset" class="link ml-3 hidden text-sm" data-work-reset>Clear filters</button>
      </p>
    </form>

    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-work-grid>
      {items.map((item, i) => <WorkCard {...item} headingLevel="h2" eager={i < 3} />)}
    </div>
    <p class="mt-10 hidden text-center text-muted" data-work-empty>
      Nothing matches that combination yet. <button type="button" class="link" data-work-clear
        >Clear filters</button
      >
    </p>
  </section>

  <Section
    id="lab"
    tone="sunken"
    eyebrow="In the lab"
    title="Built, tested — not deployed yet"
    lead="Agents and tooling that extend the same patterns to legal, telecom, logistics and IT operations. Each has its own evaluation harness and CI; public demos are coming."
  >
    <ul class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        labItems.map((item) => (
          <li class="card flex flex-col p-6">
            <div class="flex items-center justify-between gap-2">
              <span class="font-mono text-[0.7rem] tracking-wide text-muted uppercase">
                {item.note ?? item.domains.map((d) => domains[d]).join(" · ")}
              </span>
              <span class="rounded-full bg-sunken px-2 py-0.5 font-mono text-[0.65rem] text-muted uppercase">
                {statuses.lab}
              </span>
            </div>
            <h3 class="mt-3 font-serif text-xl font-medium">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">{item.summary}</p>
            <a
              href={item.repo}
              class="link mt-auto inline-flex items-center gap-1.5 pt-5 text-sm font-medium"
              target="_blank"
              rel="noopener"
              data-track="repo_click"
              data-track-label={item.title}
            >
              <Icon name="simple-icons:github" class="size-4" aria-hidden="true" />
              View repository
            </a>
          </li>
        ))
      }
    </ul>

    <h3 class="mt-14 font-sans text-sm font-semibold tracking-wide text-muted uppercase">
      Smaller projects
    </h3>
    <ul class="mt-4 divide-y divide-line rounded-2xl border border-line bg-elevated">
      {
        otherWork.map((item) => (
          <li class="flex flex-col gap-1 p-5 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
            <div>
              <p class="font-medium">{item.title}</p>
              <p class="text-sm text-muted">{item.summary}</p>
            </div>
            <a
              href={item.repo}
              class="link shrink-0 text-sm font-medium"
              target="_blank"
              rel="noopener"
              data-track="repo_click"
              data-track-label={item.title}
            >
              GitHub →
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <CTABand
    title="Want this rigor on your problem?"
    body="Tell me about the decision you're trying to improve. I'll tell you honestly whether AI is the right tool."
    primary={{ href: "/contact/", label: "Discuss a project" }}
    topic="project"
  />
</BaseLayout>

<style>
  .filter-pill {
    cursor: pointer;
  }
  .filter-pill span {
    display: inline-flex;
    border: 1px solid var(--line);
    background: var(--bg-elevated);
    color: var(--ink-soft);
    border-radius: 999px;
    padding: 0.35rem 0.85rem;
    font-size: 0.85rem;
    transition:
      background-color 150ms,
      color 150ms,
      border-color 150ms;
  }
  .filter-pill:hover span {
    border-color: var(--line-strong);
    color: var(--ink);
  }
  .filter-pill input:checked + span {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }
  .filter-pill input:focus-visible + span {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-work-filters]");
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-work-card]"));
  const count = document.querySelector("[data-work-count]");
  const empty = document.querySelector("[data-work-empty]");
  const reset = document.querySelector("[data-work-reset]");

  function current() {
    const data = new FormData(form!);
    return {
      status: String(data.get("status") ?? ""),
      domains: String(data.get("domains") ?? ""),
      capabilities: String(data.get("capabilities") ?? ""),
    };
  }

  function apply(updateUrl = true) {
    const f = current();
    let visible = 0;
    for (const card of cards) {
      const show =
        (!f.status || card.dataset.status === f.status) &&
        (!f.domains || (card.dataset.domains ?? "").split(" ").includes(f.domains)) &&
        (!f.capabilities || (card.dataset.capabilities ?? "").split(" ").includes(f.capabilities));
      card.hidden = !show;
      if (show) visible++;
    }
    if (count) count.textContent = String(visible);
    empty?.classList.toggle("hidden", visible > 0);
    const active = Object.values(f).some(Boolean);
    reset?.classList.toggle("hidden", !active);
    if (updateUrl) {
      const params = new URLSearchParams();
      Object.entries(f).forEach(([k, v]) => v && params.set(k, v));
      history.replaceState(null, "", params.size ? `?${params}` : location.pathname);
    }
  }

  if (form) {
    const params = new URLSearchParams(location.search);
    for (const key of ["status", "domains", "capabilities"]) {
      const value = params.get(key);
      if (value) {
        const input = form.querySelector<HTMLInputElement>(
          `input[name="${key}"][value="${CSS.escape(value)}"]`,
        );
        if (input) input.checked = true;
      }
    }
    form.addEventListener("change", () => apply());
    form.addEventListener("reset", () => setTimeout(() => apply(), 0));
    document.querySelector("[data-work-clear]")?.addEventListener("click", () => form.reset());
    apply(false);
  }
</script>
