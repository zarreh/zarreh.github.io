---
import MetricStrip from "@/components/MetricStrip.astro";
import Section from "@/components/Section.astro";
import type { Role } from "@/data/experience";

export interface Props {
  role: Role;
  /** Heading for the in-page navigation in the sidebar. */
  navLabel: string;
  navItems: { id: string; title: string }[];
  metrics?: readonly { value: string; label: string; context?: string }[];
  tone?: "default" | "sunken";
}

const { role, navLabel, navItems, metrics, tone } = Astro.props;
---

<Section id={role.id} tone={tone} innerClass="space-y-10">
  <div class="grid gap-10 lg:grid-cols-[16rem_minmax(0,1fr)]">
    <aside class="lg:sticky lg:top-24 lg:self-start" aria-label={`${role.org}: overview`}>
      <p class="eyebrow">{role.period}</p>
      <h2 class="mt-3 text-3xl font-medium">{role.org}</h2>
      <p class="mt-1 font-medium text-ink-soft">{role.title}</p>
      <p class="text-sm text-muted">{role.location}</p>
      {role.partner && <p class="text-sm text-muted">With {role.partner}</p>}
      <nav class="mt-8 hidden lg:block" aria-label={`${role.org}: ${navLabel}`}>
        <p class="font-mono text-xs tracking-[0.12em] text-muted uppercase">{navLabel}</p>
        <ol class="mt-3 space-y-2 border-l border-line">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={`#${item.id}`}
                  class="-ml-px block border-l border-transparent pl-4 text-sm text-ink-soft hover:border-accent hover:text-ink"
                >
                  {item.title}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </aside>

    <div class="min-w-0 space-y-10">
      <p class="lead">{role.summary}</p>
      {metrics && <MetricStrip items={metrics} />}
      <slot />
    </div>
  </div>
</Section>
