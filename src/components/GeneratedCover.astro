---
export interface Props {
  seed: string;
  label?: string;
  class?: string;
  variant?: "accent" | "warm" | "ink";
}

const { seed, label, class: className, variant = "accent" } = Astro.props;

// Deterministic pseudo-random layout so every project gets a stable, unique "system diagram".
function hash(str: string) {
  let h = 2166136261;
  for (let i = 0; i < str.length; i++) {
    h ^= str.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
}

function rng(seedValue: number) {
  let s = seedValue || 1;
  return () => {
    s ^= s << 13;
    s ^= s >>> 17;
    s ^= s << 5;
    return ((s >>> 0) % 10000) / 10000;
  };
}

const rand = rng(hash(seed));
const cols = 5;
const nodes = Array.from({ length: cols }, (_, i) => {
  const lanes = 1 + Math.floor(rand() * 3);
  return Array.from({ length: lanes }, (_, j) => ({
    x: 70 + i * 115,
    y: 180 - ((lanes - 1) * 55) / 2 + j * 55 + (rand() - 0.5) * 18,
    r: 7 + rand() * 7,
    hollow: rand() > 0.6,
  }));
});
const edges: { x1: number; y1: number; x2: number; y2: number }[] = [];
for (let i = 0; i < nodes.length - 1; i++) {
  for (const a of nodes[i]!) {
    for (const b of nodes[i + 1]!) {
      if (rand() > 0.35) edges.push({ x1: a.x, y1: a.y, x2: b.x, y2: b.y });
    }
  }
}
const highlight = Math.floor(rand() * cols);
const color =
  variant === "warm" ? "var(--warm)" : variant === "ink" ? "var(--ink)" : "var(--accent)";
---

<div
  class:list={["relative overflow-hidden bg-sunken", className]}
  role="img"
  aria-label={label ? `Abstract system diagram for ${label}` : "Abstract system diagram"}
>
  <div class="bg-grid absolute inset-0 opacity-70" aria-hidden="true"></div>
  <svg
    viewBox="0 0 600 360"
    class="relative h-full w-full"
    aria-hidden="true"
    preserveAspectRatio="xMidYMid slice"
  >
    {
      edges.map((e) => (
        <path
          d={`M${e.x1},${e.y1} C${(e.x1 + e.x2) / 2},${e.y1} ${(e.x1 + e.x2) / 2},${e.y2} ${e.x2},${e.y2}`}
          fill="none"
          stroke="var(--line-strong)"
          stroke-width="1.5"
        />
      ))
    }
    {
      nodes.flatMap((col, i) =>
        col.map((n) => (
          <circle
            cx={n.x}
            cy={n.y}
            r={n.r}
            fill={n.hollow ? "var(--bg-elevated)" : i === highlight ? color : "var(--ink-soft)"}
            stroke={i === highlight ? color : "var(--line-strong)"}
            stroke-width={n.hollow ? 2 : 0}
            opacity={i === highlight ? 1 : 0.75}
          />
        )),
      )
    }
    <rect x="40" y="300" width="160" height="6" rx="3" fill={color} opacity="0.85"></rect>
    <rect x="210" y="300" width="70" height="6" rx="3" fill="var(--line-strong)"></rect>
  </svg>
</div>
