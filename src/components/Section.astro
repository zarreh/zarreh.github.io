---
export interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  lead?: string;
  class?: string;
  innerClass?: string;
  tone?: "default" | "sunken";
  align?: "left" | "center";
}

const {
  id,
  eyebrow,
  title,
  lead,
  class: className,
  innerClass,
  tone = "default",
  align = "left",
} = Astro.props;
const headingId = id ? `${id}-title` : undefined;
---

<section
  id={id}
  aria-labelledby={title ? headingId : undefined}
  class:list={[
    "py-16 sm:py-20",
    tone === "sunken" && "border-y border-line bg-sunken/60",
    className,
  ]}
>
  <div class:list={["container-site", innerClass]}>
    {
      (eyebrow || title || lead) && (
        <div class:list={["mb-10 max-w-3xl", align === "center" && "mx-auto text-center"]}>
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          {title && (
            <h2 id={headingId} class="mt-3 text-3xl font-medium sm:text-4xl">
              {title}
            </h2>
          )}
          {lead && <p class="lead mt-4">{lead}</p>}
          <slot name="header" />
        </div>
      )
    }
    <slot />
  </div>
</section>
